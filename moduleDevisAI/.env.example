# ToolRegistry environment template

# Core provider selection
TOOLREGISTRY_PROVIDER=openai

# OpenAI settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Anthropic settings
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_TEXT_MODEL=claude-sonnet-5
ANTHROPIC_VISION_MODEL=claude-sonnet-5

# Google Gemini settings
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_TEXT_MODEL=gemini-3.8-flash
GOOGLE_VISION_MODEL=gemini-3.8-flash

# Groq settings
GROQ_API_KEY=your_groq_api_key_here
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# General registry settings
TOOLREGISTRY_TIMEOUT_SECONDS=120
TOOLREGISTRY_MAX_RETRIES=1
TOOLREGISTRY_MAX_OUTPUT_TOKENS=1024

# Logging settings
TOOLREGISTRY_LOG_LEVEL=INFO
TOOLREGISTRY_LOG_FILE=logs/toolregistry.log