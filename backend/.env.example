# ─────────────────────────────────────────────────────────────
# CRM Bâtiment API — copy to .env and adjust.
─────────────────────────────────────────────────────────────

NODE_ENV=development
APP_PORT=3000

APP_URL=http://localhost:5173

# Matches postgres port 5432 
DATABASE_URL=postgresql://postgres:password@localhost:5432/crm_batiment_local?schema=public

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-please-this-is-not-a-real-secret-0000
JWT_EXPIRES_IN=1d 

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Max JSON body size (base64 signatures need more than the 100kb default)
BODY_LIMIT=5mb

# ── Email ──
# Prod: your real SMTP (MAIL_USER / MAIL_PASS required by most providers)
# Leave MAIL_HOST empty to only print emails in the API console.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your email
MAIL_PASS=secret key SMTP
MAIL_FROM="CRM Bâtiment <your email>"

# ── Uploaded files 
# Directory OUTSIDE git (already ignored)
STORAGE_DIR=./storage
UPLOAD_MAX_MB=10

# ── AI assistant 
OPENAI_API_KEY=secretkey
OPENAI_MODEL=openai/gpt-oss-20b #model for exemple (free option)
OPENAI_BASE_URL=free option https://api.groq.com/openai/v1
OPENAI_TIMEOUT_MS=30000 #(30 seconds)

# IA — photos : nom exact d'un modèle vision de VOTRE liste Groq (vide = onglet Photo indisponible)
OPENAI_VISION_MODEL=qwen/qwen3.8-27b #free model option
OPENAI_VISION_API_KEY=
OPENAI_VISION_BASE_URL=

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=your email
IMAP_PASS=secret key imap = secret key SMTP
IMAP_FOLDER=INBOX #(filter by folder)
IMAP_POLL_MINUTES=1
IMAP_SUBJECTS=devis,demande #(filter by subject, comma-separated list)