# ─────────────────────────────────────────────────────────────
# CRM Bâtiment API — copy to .env and adjust.
# The API refuses to start if a required variable is missing or invalid.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
APP_PORT=3000
# Public URL of the web app (crm-batiment-web) — used in emails and client links
APP_URL=http://localhost:5173

# Matches docker-compose.yml (port 5433)
   DATABASE_URL=postgresql://postgres:password@localhost:5432/database_name?schema=public

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-please-this-is-not-a-real-secret-0000
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Max JSON body size (base64 signatures need more than the 100kb default)
BODY_LIMIT=5mb

# ── Email ──
# Dev: Mailpit from docker-compose catches everything -> http://localhost:8025
# Prod: your real SMTP (MAIL_USER / MAIL_PASS required by most providers)
# Leave MAIL_HOST empty to only print emails in the API console.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=youremail@gmail.com
MAIL_PASS=chei zkdr hnnv tnog
MAIL_FROM="CRM Bâtiment <youremail>"

# ── Uploaded files 
# Directory OUTSIDE git (already ignored); back it up together with the database.
STORAGE_DIR=./storage
UPLOAD_MAX_MB=10

# ── AI assistant 

OPENAI_API_KEY=#grokapikey
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_TIMEOUT_MS=30000

# IA — photos : nom exact d'un modèle vision de VOTRE liste Groq (vide = onglet Photo indisponible)
OPENAI_VISION_MODEL=qwen/qwen3.8-27b #free mdoel
OPENAI_VISION_API_KEY=
OPENAI_VISION_BASE_URL=

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=youremail@gmail.com
IMAP_PASS=
IMAP_FOLDER=INBOX
IMAP_POLL_MINUTES=1
# Seulement les emails dont l'OBJET contient un de ces mots (virgules, majuscules/accents ignorés).
# Vide = tous les emails non lus. Les autres restent non lus, le CRM n'y touche pas.
IMAP_SUBJECTS=devis,demande
# Seulement si la base contient plusieurs entreprises
IMAP_COMPANY_ID=
# Online demo (Step 15) — ONLY on a separate instance whose database name contains "demo"
# (e.g. crm_batiment_demo): the whole database is wiped and reloaded every night at 03:00,
# emails are never sent, and the login page offers one-click access per role.
DEMO_MODE=false