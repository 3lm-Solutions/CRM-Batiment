# ─────────────────────────────────────────────────────────────
# CRM Bâtiment API — copy to .env and adjust.
# The API refuses to start if a required variable is missing or invalid.
# Never commit .env: real passwords and keys go ONLY there.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
APP_PORT=3000
# Public URL of the web app (crm-batiment-web) — used in emails and client links
APP_URL=http://localhost:5173

# ── Database ──
# Local PostgreSQL: port 5432 / docker-compose.yml: port 5433 (user crm, password crm)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/crm_batiment?schema=public

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-please-this-is-not-a-real-secret-0000
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed frontend origins
# 5173 = web (Vite) · 8081 = mobile app in the browser (Expo web)
# Add your PC's local IP to test from a phone on the same Wi-Fi (e.g. http://192.168.1.12:8081)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://127.0.0.1:8081

# Max JSON body size (base64 signatures need more than the 100kb default)
BODY_LIMIT=5mb

# ── Email (SMTP or Resend API) ──
# Option 1: Resend API (HTTP, port 443 — for Render/PaaS where SMTP is blocked)
RESEND_API_KEY=
RESEND_FROM="CRM Bâtiment <onboarding@resend.dev>"

# Option 2: SMTP (empty MAIL_HOST = emails are only printed in the API console)
# Dev with docker-compose: MAIL_HOST=localhost, MAIL_PORT=1025, MAIL_SECURE=false → Mailpit http://localhost:8025
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=465, MAIL_SECURE=true + an "app password" (not the account password)
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM="CRM Bâtiment <noreply@crm-batiment.fr>"

# ── Uploaded files ──
# Option 1: Supabase Object Storage (production on Render, files are kept)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=crm-fichiers

# Option 2: local disk (default in dev). Directory OUTSIDE git; back it up with the database.
STORAGE_DIR=./storage
UPLOAD_MAX_MB=10

# ── AI assistant and Devis IA ──
# Empty key = guided mode without AI. The key stays on the server: the browser never sees it.
# Groq: OPENAI_BASE_URL=https://api.groq.com/openai/v1 · OpenAI: leave OPENAI_BASE_URL empty
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-oss-20b
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_TIMEOUT_MS=30000

# Devis IA from a photo: exact name of a vision model from YOUR Groq list
# (empty = Photo tab unavailable). Key and URL: the ones above when empty.
OPENAI_VISION_MODEL=qwen/qwen3.8-27b
OPENAI_VISION_API_KEY=
OPENAI_VISION_BASE_URL=

# Voice quote (recording → text): Whisper model, same key and URL as OPENAI_API_KEY.
# Empty = whisper-large-v3-turbo on Groq, whisper-1 on OpenAI.
OPENAI_TRANSCRIPTION_MODEL=

# ── Prospects by email: mailbox read every N minutes (IMAP) ──
# Empty IMAP_HOST = disabled. Gmail: imap.gmail.com, port 993, an "app password"
# (not the account password), and IMAP enabled in Gmail settings.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_FOLDER=INBOX
IMAP_POLL_MINUTES=5
# Only emails whose SUBJECT contains one of these words (commas, case/accents ignored).
# Empty = all unread emails. The others stay unread, the CRM does not touch them.
IMAP_SUBJECTS=devis,demande
# Only if the database contains several companies
IMAP_COMPANY_ID=

# ── Online demo ──
# ONLY on a separate instance whose database name contains "demo" (e.g. crm_batiment_demo):
# the whole database is wiped and reloaded every night at 03:00, emails are never sent,
# and the login page offers one-click access per role.
DEMO_MODE=false

# ── Mobile app ──
# Push notifications through Expo (false = no call to exp.host, e.g. tests / demo)
PUSH_ACTIF=true
# Optional: only if "Enhanced push security" is enabled on the Expo project
EXPO_ACCESS_TOKEN=
# Lifetime of the mobile refresh token (days; it changes on every use)
MOBILE_REFRESH_JOURS=60