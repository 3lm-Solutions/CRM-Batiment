# ─────────────────────────────────────────────────────────────
# CRM Bâtiment API — copy to .env and adjust.
# The API refuses to start if a required variable is missing or invalid.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
APP_PORT=3000
# Public URL of the web app (crm-batiment-web) — used in emails and client links
APP_URL=http://localhost:5173

# Postgres — your database connection (Neon or local)
DATABASE_URL=postgresql://crm:crm@localhost:5433/crm_batiment?schema=public

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-please-this-is-not-a-real-secret-0000
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Max JSON body size (base64 signatures need more than the 100kb default)
BODY_LIMIT=5mb

# ── Email (SMTP or Resend API) ──
# Option 1 : Resend API (HTTP REST, port 443 — recommandé pour Render/PaaS où SMTP est bloqué)
RESEND_API_KEY=
RESEND_FROM="CRM Bâtiment <onboarding@resend.dev>"

# Option 2 : SMTP classique (vide = affiche les emails dans la console)
MAIL_HOST=
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="CRM Bâtiment <noreply@crm-batiment.fr>"

# ── Uploaded files ──
# Option 1 : Supabase Object Storage (recommandé en production sur Render pour persistance des fichiers)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=crm-fichiers

# Option 2 : Disque local (par défaut en dev local)
STORAGE_DIR=./storage
UPLOAD_MAX_MB=10

# ── AI assistant (Step 14) ──
# Empty key = guided mode without AI (collects the prospect's details, answers from the
# knowledge base). The key stays on the server: the browser never sees it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Grok (xAI) instead of OpenAI: OPENAI_BASE_URL=https://api.x.ai/v1 + an xAI key + a Grok model
OPENAI_BASE_URL=
OPENAI_TIMEOUT_MS=20000
# Devis IA depuis une photo : un modèle qui LIT LES IMAGES (vide = onglet Photo indisponible).
# Clé et URL : celles du dessus si vides. Groq : qwen/qwen3.8-27b (voir console.groq.com/docs/vision)
# OpenAI : gpt-4o-mini + OPENAI_VISION_API_KEY=sk-... + OPENAI_VISION_BASE_URL vide
OPENAI_VISION_MODEL=
OPENAI_VISION_API_KEY=
OPENAI_VISION_BASE_URL=
# Devis vocal (enregistrement → texte) : modèle Whisper, même clé et URL que OPENAI_API_KEY.
# Vide = whisper-large-v3-turbo chez Groq, whisper-1 chez OpenAI.
OPENAI_TRANSCRIPTION_MODEL=

# ── Prospects par email (22/10) : boîte dédiée lue toutes les N minutes (IMAP) ──
# Vide = désactivé. Gmail : imap.gmail.com, port 993, « mot de passe d'application »
# (pas le mot de passe du compte), et IMAP activé dans les paramètres Gmail.
# Chaque email NON LU du dossier devient un prospect (ou est écarté par l'IA), puis est marqué lu.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_FOLDER=INBOX
IMAP_POLL_MINUTES=5
# Seulement les emails dont l'OBJET contient un de ces mots (virgules, majuscules/accents ignorés).
# Vide = tous les emails non lus. Les autres restent non lus, le CRM n'y touche pas.
IMAP_SUBJECTS=devis,demande
# Seulement si la base contient plusieurs entreprises
IMAP_COMPANY_ID=

# ── Added in later steps ──

# Online demo (Step 15) — ONLY on a separate instance whose database name contains "demo"
# (e.g. crm_batiment_demo): the whole database is wiped and reloaded every night at 03:00,
# emails are never sent, and the login page offers one-click access per role.
DEMO_MODE=false
