# --- Connexion à la base Postgres partagée avec le schéma Prisma du CRM ---
DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/devis_ia

# --- Stratégie catalogue : "few_shot" ou "rag" ---
CATALOGUE_STRATEGY=few_shot

# --- Paramètres RAG (utilisés seulement si CATALOGUE_STRATEGY=rag) ---
CATALOGUE_RAG_SIMILARITY_THRESHOLD=0.80790842
CATALOGUE_RAG_EMBEDDINGS_PATH=data/mistral_catalogue_embeddings.npz
CATALOGUE_RAG_EMBEDDING_MODEL=mistral-embed
MISTRAL_API_KEY=

# --- Durée de cache en mémoire du contexte catalogue par entreprise (secondes) ---
CATALOGUE_CACHE_TTL_SECONDS=300
