# Copier ce fichier vers .env et remplir les valeurs.
# Fusion des variables catalogue/ + toolregistry/

# --- Postgres (schéma Prisma du CRM) ---
# Avec Docker : docker compose up -d  puis utiliser l'URL ci-dessous
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devis_ia_test

# --- Catalogue ---
CATALOGUE_STRATEGY=few_shot
CATALOGUE_RAG_SIMILARITY_THRESHOLD=0.80790842
CATALOGUE_RAG_EMBEDDINGS_PATH=data/mistral_catalogue_embeddings.npz
CATALOGUE_RAG_EMBEDDING_MODEL=mistral-embed
CATALOGUE_CACHE_TTL_SECONDS=300

# --- Clés API LLM ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=

# --- Providers ---
TEXTE_PROVIDER=openai
TEXTE_MODEL=gpt-4o-mini
TEXTE_FALLBACK_PROVIDER=anthropic
TEXTE_FALLBACK_MODEL=claude-3-5-haiku-20241022

VISION_PROVIDER=anthropic
VISION_MODEL=claude-3-7-sonnet-20250219
VISION_FALLBACK_PROVIDER=google
VISION_FALLBACK_MODEL=gemini-2.0-flash

TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_MODEL=whisper-1

TOOLREGISTRY_TIMEOUT_SECONDS=30

# --- Envoi du PDF de devis par e-mail (SMTP) ---
# Le statut ENVOYE n'est appliqué qu'après l'envoi SMTP réussi.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
