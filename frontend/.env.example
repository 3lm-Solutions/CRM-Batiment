# Base URL of the API as seen by the browser.
# Keep "/api/v1" in dev: Vite proxies it to http://localhost:3000 (see vite.config.ts).
VITE_API_URL=/api/v1
# Websocket origin for real-time notifications. Empty in dev (Vite proxies /socket.io).
# In production, set it if the API is on another domain, e.g. https://api.mon-crm.fr
VITE_WS_URL=

# Company answered by the public chatbot (/chat). Can also be passed as ?entreprise=ID.
VITE_CHATBOT_COMPANY_ID=1

# Address of the online demo instance (Step 15), linked from the public /demo page. Empty = no link.
VITE_DEMO_URL=
